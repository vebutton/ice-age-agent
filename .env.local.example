# Copy to .env.local (gitignored) and fill in real values.
# Then before starting Claude Code in this project:
#   source .env.local && claude
#
# Every line must be `export KEY="value"`. A bare value makes `source` try to
# EXECUTE it — the shell prints `command not found: <secret>` and the secret
# lands in terminal output and session transcripts.

# Slack bot token for the work channel (korotovsky/slack-mcp-server).
export SLACK_MCP_XOXB_TOKEN="xoxb-REPLACE-ME"

# AgentMail API key — Sage's own inbox.
export AGENTMAIL_API_KEY="REPLACE-ME"

# GitHub fine-grained PAT for work-org repo reads.
# WARNING: setting this OVERRIDES `gh auth login`. If it is expired, every gh
# command fails even though the keyring login is fine. Unset it rather than
# leave a stale value. Check with `gh auth status`.
export GITHUB_TOKEN="REPLACE-ME"

# Optional — not needed for reading. Reddit is read unauthenticated via the
# Playwright MCP; the Cloudflare blog is public.
# export REDDIT_USERNAME="REPLACE-ME"
# export REDDIT_PASSWORD="REPLACE-ME"
# export CLOUDFLARE_EMAIL="REPLACE-ME"
# export CLOUDFLARE_PASSWORD="REPLACE-ME"
